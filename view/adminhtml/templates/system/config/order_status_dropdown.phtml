<script>
require(['jquery', 'domReady!'], function ($) {
    var $fieldset = $('#ekomiintegration_general');
    if (!$fieldset.length || $fieldset.data('ekomiCardsInit')) {
        return;
    }
    $fieldset.data('ekomiCardsInit', true);

    // 1. Convert Top Comment into a clean Branded Notice Banner
    var $origComment = $fieldset.children('.comment');
    var commentHtml = $origComment.length ? $origComment.html() : "If you do not have an account with eKomi, please register <a href='https://store.ekomiapps.de/en/register?package=local-star&app=plugin-magento2' target='_blank'>Here</a> or contact our <a href='mailto:support@ekomi.de'>support</a>";
    $origComment.hide();

    var $banner = $(
        '<div class="ekomi-brand-banner">' +
        '  <div class="ekomi-notice-icon">' +
        '    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>' +
        '  </div>' +
        '  <div class="ekomi-brand-text">' + commentHtml + '</div>' +
        '</div>'
    );
    $fieldset.prepend($banner);

    // 2. Convert Tooltips into Visible Notes under Controls (Matching Motivation Screenshot)
    $fieldset.find('tr[id^="row_"]').each(function () {
        var $tr = $(this);
        var $tooltip = $tr.find('.tooltip');
        var $note = $tr.find('.note');
        if ($tooltip.length) {
            var tooltipText = $tooltip.find('.tooltip-content').text().trim();
            if (tooltipText && !$note.length) {
                $tr.find('td.value').append($('<p class="note"><span>' + tooltipText + '</span></p>'));
            }
            $tooltip.remove(); // Remove awkward floating (?) icon
        }
    });

    // 3. Define Card Metadata & Icons
    var cardsConfig = [
        {
            id: 'general',
            iconColor: 'ekomi-icon-blue',
            iconSvg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
            title: 'General Settings',
            subtitle: 'Enable plugin and set review delivery mode',
            rowIds: [
                'row_ekomiintegration_general_active',
                'row_ekomiintegration_general_review_mod',
                'row_ekomiintegration_general_shop_id',
                'row_ekomiintegration_general_shop_password'
            ]
        },
        {
            id: 'product_reviews',
            iconColor: 'ekomi-icon-green',
            iconSvg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>',
            title: 'Product Reviews',
            subtitle: 'Configure product-level review collection and identifiers',
            rowIds: [
                'row_ekomiintegration_general_product_reviews',
                'row_ekomiintegration_general_product_identifier',
                'row_ekomiintegration_general_exclude_products'
            ]
        },
        {
            id: 'orders',
            iconColor: 'ekomi-icon-purple',
            iconSvg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
            title: 'Order Trigger & Export',
            subtitle: 'Select which order statuses trigger a review invitation and timing',
            rowIds: [
                'row_ekomiintegration_general_export_method',
                'row_ekomiintegration_general_turnaround_time',
                'row_ekomiintegration_general_order_status'
            ]
        },
        {
            id: 'terms',
            iconColor: 'ekomi-icon-indigo',
            iconSvg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>',
            title: 'Terms & Conditions',
            subtitle: 'Service compliance and order export agreement',
            rowIds: [
                'row_ekomiintegration_general_terms_and_conditions'
            ]
        }
    ];

    // 4. Build Cards Structure
    var $cardsWrap = $('<div class="ekomi-cards-wrap"></div>');

    cardsConfig.forEach(function (card) {
        var $card = $('<div class="ekomi-card ekomi-card-' + card.id + '"></div>');
        var $header = $(
            '<div class="ekomi-card-header">' +
            '  <div class="ekomi-card-icon ' + card.iconColor + '">' + card.iconSvg + '</div>' +
            '  <div class="ekomi-card-title-group">' +
            '    <h3 class="ekomi-card-title">' + card.title + '</h3>' +
            '    <p class="ekomi-card-subtitle">' + card.subtitle + '</p>' +
            '  </div>' +
            '</div>'
        );
        var $body = $('<div class="ekomi-card-body"></div>');
        var $table = $('<table class="form-list" cellspacing="0"><tbody></tbody></table>');

        if (card.id === 'terms') {
            var $box = $(
                '<div class="ekomi-terms-box">' +
                '  <div class="ekomi-terms-box-header">' +
                '    <div class="ekomi-terms-box-title">' +
                '      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>' +
                '      <span>Legal Authorization & Service Agreement</span>' +
                '    </div>' +
                '    <span class="ekomi-terms-badge">Required</span>' +
                '  </div>' +
                '</div>'
            );
            $box.append($table);
            $body.append($box);
        } else {
            $body.append($table);
        }

        // Move matching rows into this card
        card.rowIds.forEach(function (rowId) {
            var $row = $('#' + rowId);
            if ($row.length) {
                if (rowId === 'row_ekomiintegration_general_exclude_products' ||
                    rowId === 'row_ekomiintegration_general_order_status' ||
                    rowId === 'row_ekomiintegration_general_terms_and_conditions') {
                    $row.addClass('ekomi-row-full');
                }
                $table.children('tbody').append($row);
            }
        });

        $card.append($header).append($body);
        $cardsWrap.append($card);
    });

    $fieldset.append($cardsWrap);

    // 5. Password Eye Toggle
    var $pwd = $('#ekomiintegration_general_shop_password');
    if ($pwd.length && !$pwd.data('ekomiPwdInit')) {
        $pwd.data('ekomiPwdInit', true);
        var $pwdWrap = $('<div class="ekomi-password-wrap"></div>');
        $pwd.wrap($pwdWrap);

        var eyeOpenSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
        var eyeSlashSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

        var $eyeBtn = $('<button type="button" class="ekomi-password-toggle" title="Hide password" aria-label="Toggle password visibility"></button>').html(eyeSlashSvg);
        $pwd.attr('type', 'password');
        $pwd.after($eyeBtn);

        $eyeBtn.on('click', function (e) {
            e.preventDefault();
            var isPass = $pwd.attr('type') === 'password';
            $pwd.attr('type', isPass ? 'text' : 'password');
            $eyeBtn.html(isPass ? eyeSlashSvg : eyeOpenSvg).attr('title', isPass ? 'Hide password' : 'Show password');
        });
    }

    // 6. Order Status Multiselect Dropdown
    var $orderStatusSelect = $('#ekomiintegration_general_order_status');
    if ($orderStatusSelect.length && !$orderStatusSelect.data('ekomiDropdownInit')) {
        $orderStatusSelect.data('ekomiDropdownInit', true);

        var $wrap = $('<div class="ekomi-multiselect-dropdown-wrap"></div>');
        var $toggle = $('<div class="ekomi-multiselect-toggle admin__control-select" tabindex="0" role="combobox" aria-expanded="false"></div>');
        var $menu = $('<div class="ekomi-multiselect-menu"></div>');

        function updateSummary() {
            var selectedLabels = [];
            $orderStatusSelect.find('option:selected').each(function () {
                selectedLabels.push($(this).text().trim());
            });

            if (selectedLabels.length === 0) {
                $toggle.html('<span class="ekomi-multiselect-placeholder">-- Select Order Statuses --</span>');
                $toggle.removeAttr('title');
            } else if (selectedLabels.length <= 2) {
                $toggle.text(selectedLabels.join(', '));
                $toggle.attr('title', selectedLabels.join(', '));
            } else {
                $toggle.html('<span class="ekomi-multiselect-count-badge">' + selectedLabels.length + '</span> ' + selectedLabels.slice(0, 2).join(', ') + '...');
                $toggle.attr('title', selectedLabels.join(', '));
            }

            var disabled = $orderStatusSelect.prop('disabled');
            $toggle.toggleClass('is-disabled', !!disabled);
            $menu.find('input[type="checkbox"]').prop('disabled', !!disabled);
        }

        $orderStatusSelect.find('option').each(function () {
            var $opt = $(this);
            var $item = $('<label class="ekomi-multiselect-item"></label>');
            var $chk = $('<input type="checkbox">');

            $chk.prop('checked', $opt.prop('selected'));
            if ($opt.prop('selected')) {
                $item.addClass('is-selected');
            }

            $chk.on('change', function () {
                $opt.prop('selected', this.checked);
                $item.toggleClass('is-selected', this.checked);
                $orderStatusSelect.trigger('change');
                updateSummary();
            });

            $item.append($chk);
            $item.append($('<span class="ekomi-multiselect-item-label"></span>').text($opt.text().trim()));
            $menu.append($item);
        });

        $toggle.on('click', function (e) {
            if ($orderStatusSelect.prop('disabled')) {
                return;
            }
            $wrap.toggleClass('is-open');
            $toggle.attr('aria-expanded', $wrap.hasClass('is-open'));
        });

        $toggle.on('keydown', function (e) {
            if (e.which === 13 || e.which === 32) {
                e.preventDefault();
                $toggle.trigger('click');
            } else if (e.which === 27) {
                $wrap.removeClass('is-open');
                $toggle.attr('aria-expanded', 'false');
            }
        });

        $(document).on('click', function (e) {
            if (!$wrap.is(e.target) && !$wrap.has(e.target).length) {
                $wrap.removeClass('is-open');
                $toggle.attr('aria-expanded', 'false');
            }
        });

        $wrap.append($toggle).append($menu);
        $wrap.insertAfter($orderStatusSelect);
        updateSummary();

        $orderStatusSelect.on('change', function () {
            $menu.find('.ekomi-multiselect-item').each(function (i) {
                var isSelected = $orderStatusSelect.find('option').eq(i).prop('selected');
                $(this).find('input[type="checkbox"]').prop('checked', isSelected);
                $(this).toggleClass('is-selected', isSelected);
            });
            updateSummary();
        });
    }

    // 7. Exclude Products Tag / Chip Input
    var $exInput = $('#ekomiintegration_general_exclude_products');
    if ($exInput.length && !$exInput.data('ekomiChipsInit')) {
        $exInput.data('ekomiChipsInit', true);

        var $chipsWrap = $('<div class="ekomi-chips-wrap"></div>');
        var $chipInputField = $('<input type="text" class="ekomi-chip-input" placeholder="e.g. 101, 205, 310 (Type SKU or ID & press Enter)">');

        function parseChipsFromInput() {
            var val = $exInput.val() || '';
            return val.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
        }

        function saveChipsToInput(chips) {
            $exInput.val(chips.join(',')).trigger('change');
        }

        function renderChips() {
            $chipsWrap.find('.ekomi-chip').remove();
            var chips = parseChipsFromInput();
            chips.forEach(function (chip, i) {
                var $chip = $('<span class="ekomi-chip"></span>').text(chip);
                var $removeBtn = $('<button type="button" class="ekomi-chip-remove" title="Remove">&times;</button>');
                $removeBtn.on('click', function (e) {
                    e.stopPropagation();
                    chips.splice(i, 1);
                    saveChipsToInput(chips);
                    renderChips();
                });
                $chip.append($removeBtn);
                $chipInputField.before($chip);
            });

            var disabled = $exInput.prop('disabled');
            $chipsWrap.toggleClass('is-disabled', !!disabled);
            $chipInputField.prop('disabled', !!disabled);
        }

        function addChip(val) {
            val = (val || '').trim();
            if (!val) {
                return;
            }
            var chips = parseChipsFromInput();
            if (chips.indexOf(val) === -1) {
                chips.push(val);
                saveChipsToInput(chips);
                renderChips();
            }
            $chipInputField.val('');
        }

        $chipInputField.on('keydown', function (e) {
            if (e.which === 13 || e.which === 188) { // Enter or comma
                e.preventDefault();
                addChip($(this).val());
            } else if (e.which === 8 && !$(this).val()) { // Backspace on empty
                var chips = parseChipsFromInput();
                if (chips.length) {
                    chips.pop();
                    saveChipsToInput(chips);
                    renderChips();
                }
            }
        });

        $chipInputField.on('blur', function () {
            if ($(this).val()) {
                addChip($(this).val());
            }
            $chipsWrap.removeClass('is-focused');
        });
        $chipInputField.on('focus', function () {
            $chipsWrap.addClass('is-focused');
        });

        $chipsWrap.on('click', function () {
            $chipInputField.focus();
        });

        $chipsWrap.append($chipInputField);
        $chipsWrap.insertAfter($exInput);
        renderChips();

        $exInput.on('change', function () {
            renderChips();
        });
    }
});
</script>
<?php endif; ?>
